# Release signing via 1Password (ADR-0019). Safe to commit: it holds only
# 1Password secret references, never the secrets themselves.
#
# One-time setup per machine:
#   op document get "Android release keystore" --vault Private \
#     --out-file ~/.android-keys/release.jks
#
# Build a signed release:
#   op run --env-file=release.env -- ./gradlew bundleRelease
#
# Adjust the vault, item and field names below if yours differ.
ANDROID_KEYSTORE_FILE=~/.android-keys/release.jks
KEYSTORE_PASSWORD=op://Private/Android release keystore/store_password
KEY_ALIAS=op://Private/Android release keystore/key_alias
KEY_PASSWORD=op://Private/Android release keystore/key_password
